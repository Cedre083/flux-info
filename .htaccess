# ============================================================
# FLUX-INFO.NET - .htaccess
# Acces public ouvert aux moteurs de recherche, robots et agents IA
# Aucun filtrage ni blocage par User-Agent
# ============================================================

# ------------------------------------------------------------
# 1. Index par defaut et protection contre le listing de dossiers
# ------------------------------------------------------------
DirectoryIndex index.php index.html
Options -Indexes

# ------------------------------------------------------------
# 2. HTTPS + domaine canonique sans www
#    Conserve les chemins et les parametres de requete
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Ne jamais bloquer le repertoire ACME / Let's Encrypt
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Force HTTPS, y compris derriere un proxy/CDN qui renseigne X-Forwarded-Proto
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://flux-info.net%{REQUEST_URI} [R=301,L]

    # Canonique : www.flux-info.net -> flux-info.net
    RewriteCond %{HTTP_HOST} ^www\.flux-info\.net$ [NC]
    RewriteRule ^ https://flux-info.net%{REQUEST_URI} [R=301,L]

    # URL canonique : index.php -> racine du site
    # THE_REQUEST evite de perturber DirectoryIndex
    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]|$) [NC]
    RewriteRule ^index\.php$ / [R=301,L]
</IfModule>

# ------------------------------------------------------------
# 3. Acces public
#    Les robots classiques et agents IA ne sont PAS bloques ici.
#    Le controle d'exploration reste gere par robots.txt.
# ------------------------------------------------------------
<IfModule mod_authz_core.c>
    Require all granted
</IfModule>

# ------------------------------------------------------------
# 4. Protection des fichiers caches et sensibles
#    .well-known reste accessible pour les certificats HTTPS.
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
</IfModule>

<FilesMatch "(?i)(^\.env|^composer\.(json|lock)$|^package(-lock)?\.json$|^yarn\.lock$|^phpunit\.xml$|\.(?:ini|conf|sql|sqlite|db|log|bak|old|orig|swp|dist)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ------------------------------------------------------------
# 5. En-tetes de securite non intrusifs
#    Pas de CSP stricte ici afin de ne pas casser les scripts du site.
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # HSTS uniquement en HTTPS
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# ------------------------------------------------------------
# 6. Compression des ressources texte
# ------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml application/rss+xml application/ld+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ------------------------------------------------------------
# 7. Cache navigateur pour les ressources statiques
#    Les pages PHP/HTML dynamiques ne recoivent pas de cache long ici.
# ------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 month"

    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    ExpiresDefault "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    <FilesMatch "\.(?:avif|webp|png|jpe?g|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    <FilesMatch "\.(?:php|html?)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# 8. Encodage UTF-8
# ------------------------------------------------------------
AddDefaultCharset UTF-8

# ============================================================
# IMPORTANT ROBOTS / IA
# ------------------------------------------------------------
# Aucune regle SetEnvIf, RewriteCond USER_AGENT, Require not env,
# Deny from ou autre mecanisme de ce fichier ne bloque GPTBot,
# OAI-SearchBot, ChatGPT-User, ClaudeBot, PerplexityBot, Googlebot,
# Bingbot ou tout autre robot public.
#
# robots.txt contient :
#   User-agent: *
#   Allow: /
# Ce qui rend le contenu public explorable par tous les agents
# respectant robots.txt, hors repertoires techniques explicitement exclus.
# ============================================================
